			)
			(justify left)
		)
		(uuid "13ac099a-951a-456b-92ae-e48fcc99db73")
	)
	(text "Active-LOW:\nuse it as a sink.\nCPU HALT -> 0V\nCPU EXEC -> 5V\ncurrent = ~5mA"
		(exclude_from_sim no)
		(at 14.478 163.068 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
		)
		(uuid "1daaf462-c4b8-4676-b480-cd95db097dfa")
	)
	(text "Active-LOW:\nDefault as DISABLED.\nOnly READ on LOW(0)."
		(exclude_from_sim no)
		(at 13.97 116.586 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
		)
		(uuid "21b11cc6-8177-4bef-8053-4015e9f93875")
	)
	(text "Active-LOW:\nDefault as DISABLED.\nOnly REQUEST on LOW(0)."
		(exclude_from_sim no)
		(at 13.97 110.236 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
		)
		(uuid "24461067-3b1f-4344-8a2f-62512f55cb2b")
	)
	(text "UART"
		(exclude_from_sim no)
		(at 210.312 56.134 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4c0d54f8-92a0-46b2-900b-5edbc0ac83d8")
	)
	(text "MMU"
		(exclude_from_sim no)
		(at 202.184 39.116 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "675cbef9-891f-4acb-a64a-99388a48fc27")
	)
	(text "ROLES:\nPulze Z80_CLK @ 8Mhz.\n\nIOREQ Captures:\n/WR - Writing Data \n/RD - Reading Data\n\nControl: \nI2C, SPI, UART. MMU.\n"
		(exclude_from_sim no)
		(at 250.19 22.352 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "6b0ef437-11f5-436a-b614-4746d99a623f")
	)
	(text "512K EEPROM\nRead/Write at 5V.\n19-bit Address Bus.\n8-bit Data Bus."
		(exclude_from_sim no)
		(at 144.272 19.812 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "708f1f66-9bd8-4698-ad73-ac3a214b2a78")
	)
	(text "Active-LOW:\nDisabled by Default.\nOnly need to wait for slow SRAM.\nAS6C4008 is 55ns too fast to wait."
		(exclude_from_sim no)
		(at 14.478 129.794 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
		)
		(uuid "810b2e3c-e016-4d98-9801-5aa73c78b0a5")
	)
	(text "Active-LOW:\nNeed Pull-UP HIGH to keeps \nZ80 running normally until \nPIC requests the bus."
		(exclude_from_sim no)
		(at 14.478 145.288 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
		)
		(uuid "8426a582-c051-4a3a-8dc3-7548c06230b9")
	)
	(text "Vector \nBytes"
		(exclude_from_sim no)
		(at 261.62 81.534 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "8e0dc221-ad39-42cc-a608-07e7cd49beb2")
	)
	(text "MicroSD Card may drain further,\nSo this 10UF is for that."
		(exclude_from_sim no)
		(at 217.424 146.558 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "9a7a7e4a-cf48-469d-82bd-03c60686ea0f")
	)
	(text "Active-LOW :\nIt must be tied High via \na resistor to prevent random, \nunrecoverable system resets."
		(exclude_from_sim no)
		(at 13.97 137.414 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
		)
		(uuid "9be52594-533b-4655-a259-5259feaa40b6")
	)
	(text "Active-LOW:\nPull-UP HIGH to Disable. \nLOW to Signal Z80 Reset."
		(exclude_from_sim no)
		(at 15.494 179.832 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
